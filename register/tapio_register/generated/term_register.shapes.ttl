@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tapio: <https://tapio.finntegrate.org/schema/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tapio:TermRegister a sh:NodeShape ;
    rdfs:comment "One dated, immutable edition of the register. Concepts are never removed between editions: an entity that leaves force gains a ``valid_until`` and a ``superseded_by`` pointer instead (ADR 0007, decision 5)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class skos:Concept ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path tapio:concepts ],
        [ sh:datatype xsd:string ;
            sh:description "What this edition covers, in one paragraph." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tapio:description ],
        [ sh:datatype xsd:string ;
            sh:description "The statement of what the register does and does not record, published with every edition. The register records what its sources said on the dates they were observed, not ground truth; a gap in it is evidence of a gap in Tapio's attention, not evidence that nothing happened." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path tapio:coverage_caveat ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of this edition." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tapio:title ],
        [ sh:datatype xsd:date ;
            sh:description "The release date of this edition, used verbatim as the ``register_version`` field of a provenance record. Dated and immutable, never a rolling identifier such as \"main\"." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tapio:register_version ],
        [ sh:datatype xsd:string ;
            sh:description "SPDX-style identifier or URL of the licence the edition is released under." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tapio:license ] ;
    sh:targetClass tapio:TermRegister .

skos:Concept a sh:NodeShape ;
    rdfs:comment "One entity a guide answer may refer to: an authority, a permit, a step in a process, a document, a legal status, a service, a legal act, or a term of art. Closed world - an entity absent from the register cannot be asserted." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "What took this entity's place. Populated whenever ``valid_until`` is set, and what lets G5 auto-repair a stale assertion without a second model call." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:isReplacedBy ],
        [ sh:datatype xsd:date ;
            sh:description "The last date on which this entity was in force, inclusive, and absent while it still is. A body dissolved on 1 January 2025 therefore carries 2024-12-31, and its successor's ``valid_from`` is 2025-01-01, so the two intervals meet without a gap or an overlap. A present-tense claim naming a concept whose ``valid_until`` has passed fails G5." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path sdo:validThrough ],
        [ sh:class tapio:Observation ;
            sh:description "Where this entity was seen, and when. At least one per concept: the register records what a named source said on a given date, and this is what lets a reader judge its coverage rather than take it on faith." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path tapio:observations ],
        [ sh:description "The authority responsible for this permit, step, or service. Time-sliced by the validity of both ends, which is what makes \"who was responsible in year N\" answerable." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path tapio:handledBy ],
        [ sh:datatype xsd:date ;
            sh:description "The earliest date from which the register is prepared to treat this entity as in force. Where a source names a commencement date, that date is used; otherwise it is the register's floor date, which records that the register has no evidence of a start date and asserts nothing earlier. Required from day one: it is what lets gate G5 check a historical claim against the state of affairs at its own reference date rather than against today." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path sdo:validFrom ],
        [ sh:class tapio:AltLabels ;
            sh:description "Other surface forms the same entity is published under, including abbreviations and superseded names. Read by the ``ground`` node, so a user typing either form resolves to the same IRI." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path skos:altLabel ],
        [ sh:description "An associative link that is not subsumption." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path skos:related ],
        [ sh:datatype xsd:string ;
            sh:description "The code this entity carries in an official code list, where it has one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path skos:notation ],
        [ sh:description "What sort of entity this is. Determines the IRI prefix and the RDF type." ;
            sh:in ( "organization" "permit" "step" "document" "status" "service" "legal_act" "term" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path tapio:kind ],
        [ sh:description "Stable IRI, written as a CURIE whose prefix matches ``kind`` (``org:`` for an organization, ``permit:`` for a permit, and so on)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path tapio:id ],
        [ sh:datatype xsd:string ;
            sh:description "What changed, in one sentence, when this entity was superseded or re-scoped." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path skos:changeNote ],
        [ sh:description "An external concept close enough to be useful but not equivalent. Used where YSO carries the general term and the register carries the Finnish administrative specific." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path skos:closeMatch ],
        [ sh:description "The guides whose remit this concept falls within. A guide's scope is the set of concepts naming it here, which is what gate G3 checks instead of a hand-written English sentence." ;
            sh:in ( "tapio" "ilmarinen" "sampo" "rauni" "otso" ) ;
            sh:minCount 1 ;
            sh:order 15 ;
            sh:path tapio:in_scope_of ],
        [ sh:class tapio:PrefLabels ;
            sh:description "The one preferred label per language. Every concept carries all three." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path skos:prefLabel ],
        [ sh:description "The more general concept this one falls under." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path skos:broader ],
        [ sh:description "An external concept this one is equivalent to, in YSO, JUPO, PTV, or another published vocabulary." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path skos:exactMatch ],
        [ sh:class tapio:Definitions ;
            sh:description "A short gloss, in whichever languages have been reviewed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path skos:definition ] ;
    sh:targetClass skos:Concept .

tapio:AltLabels a sh:NodeShape ;
    rdfs:comment "Additional surface forms, per language." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "English alternative labels." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tapio:en ],
        [ sh:datatype xsd:string ;
            sh:description "Swedish alternative labels." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tapio:sv ],
        [ sh:datatype xsd:string ;
            sh:description "Finnish alternative labels." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tapio:fi ] ;
    sh:targetClass tapio:AltLabels .

tapio:Definitions a sh:NodeShape ;
    rdfs:comment "A short gloss, per language. Languages are filled in as they are reviewed." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Swedish definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tapio:sv ],
        [ sh:datatype xsd:string ;
            sh:description "Finnish definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tapio:fi ],
        [ sh:datatype xsd:string ;
            sh:description "English definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tapio:en ] ;
    sh:targetClass tapio:Definitions .

tapio:Observation a sh:NodeShape ;
    rdfs:comment "One record of a source stating something about a concept, on a date." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "When Tapio looked, which is not when reality changed. The distinction matters when reading the register as a record of administrative change." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:date ],
        [ sh:description "The exact page or API response observed, not a site root." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dcterms:source ],
        [ sh:description "The publisher the observation came from." ;
            sh:in ( "yso" "jupo" "suomi_fi_terminologies" "koodistot" "ptv" "suomi_fi" "migri" "enter_finland" "finlex" "infofinland" "dvv" "kela" "police" "tyomarkkinatori" "corpus" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path tapio:source ],
        [ sh:datatype xsd:string ;
            sh:description "What this source contributed, where that is not obvious." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path tapio:note ] ;
    sh:targetClass tapio:Observation .

tapio:PrefLabels a sh:NodeShape ;
    rdfs:comment "The preferred label in each of the three languages the corpus is grounded in." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Finnish preferred label." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path tapio:fi ],
        [ sh:datatype xsd:string ;
            sh:description "Swedish preferred label." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path tapio:sv ],
        [ sh:datatype xsd:string ;
            sh:description "English preferred label." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path tapio:en ] ;
    sh:targetClass tapio:PrefLabels .

