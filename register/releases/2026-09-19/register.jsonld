    {
      "@id": "step:dublin-procedure",
      "@type": [
        "skos:Concept",
        "tapio:ProcessStep"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The Dublin procedure is based on the EU Dublin Regulation and is conducted to determine the state responsible for examining an asylum application. The member states of the EU as well as Iceland, Liechtenstein, Norway and Switzerland apply the Regulation. Another country can be responsible for examining an application if the asylum seeker, for example, has family ties, a residence permit or a visa in another country applying the Regulation. Another country is also responsible for examining an application if the asylum seeker’s fingerprints have been entered in the Eurodac system after an illegal crossing of the external border of the EU. The country where an asylum seeker has previously sought asylum may also be responsible for examining the application. See European Union (EU), asylum."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Dublin procedure"
        },
        {
          "@language": "fi",
          "@value": "Dublin-menettely"
        },
        {
          "@language": "sv",
          "@value": "Dublinförfarande"
        }
      ],
      "tapio:observation": {
        "@id": "_:Nd6513c3dae884bd196ab94e9bd56a685"
      }
    },
    {
      "@id": "_:Nd6513c3dae884bd196ab94e9bd56a685",
      "@type": "tapio:Observation",
      "dcterms:date": {
        "@type": "xsd:date",
        "@value": "2026-09-19"
      },
      "dcterms:publisher": "migri",
      "dcterms:source": {
        "@id": "https://migri.fi/en/glossary"
      }
    },
    {
      "@id": "step:determine-citizenship-status",
      "@type": [
        "skos:Concept",
        "tapio:ProcessStep"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2003-06-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "In unclear situations, the Finnish Immigration Service establishes which citizenship a person is considered to hold in Finland. See also citizenship."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
