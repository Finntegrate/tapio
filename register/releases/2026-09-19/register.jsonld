    {
      "@id": "term:ethnic-nationality",
      "@type": [
        "skos:Concept",
        "tapio:Term"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Ethnic background. Belonging to a specific nation or a group of people (e.g. Ingrian Finns, Kurds, Roma). Ethnic nationality has a different meaning than citizenship. For instance, a person of Kurdish ethnic origin may hold Finnish citizenship. Cf. citizenship."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
