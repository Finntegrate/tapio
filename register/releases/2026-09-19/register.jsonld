    {
      "@id": "status:humanitarian-protection",
      "@type": [
        "skos:Concept",
        "tapio:LegalStatus"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "sdo:validThrough": {
        "@type": "xsd:date",
        "@value": "2016-05-16"
      },
      "skos:changeNote": {
        "@language": "en",
        "@value": "Ceased to be a ground for granting a residence permit on 16 May 2016; nothing replaced it directly. Applicants are assessed for asylum and subsidiary protection instead."
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Reason for granting a residence permit until 16 May 2016. It was possible to grant a residence permit on the basis of humanitarian protection when the requirements for granting asylum or providing subsidiary protection were not met, but the applicant could not return to his or her home country or country of former habitual residence because of an environmental catastrophe. Another possible reason was a poor security situation which might have been due to an armed conflict or a poor human rights situation. See also asylum, subsidiary protection."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "humanitarian protection"
        },
        {
          "@language": "fi",
          "@value": "humanitaarinen suojelu"
        },
        {
          "@language": "sv",
          "@value": "humanitärt skydd"
        }
      ],
      "skos:related": {
        "@id": "status:subsidiary-protection"
      },
      "tapio:observation": {
        "@id": "_:N15538a382b2f487194251529e741ec49"
      }
    },
