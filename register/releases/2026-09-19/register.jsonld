    {
      "@id": "step:asylum-examination",
      "@type": [
        "skos:Concept",
        "tapio:ProcessStep"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A procedure in which the Finnish Immigration Service or the Border Guard first establishes the identity and travel route of the asylum seeker and whether his or her application can be processed in Finland. After that, the Finnish Immigration Service interviews the applicant in order to establish the grounds for his or her asylum application. See asylum interview."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "asylum examination"
        },
        {
          "@language": "fi",
          "@value": "turvapaikkatutkinta"
        },
        {
          "@language": "sv",
          "@value": "asylutredning"
        }
      ],
      "tapio:handledBy": {
        "@id": "org:migri"
      },
      "tapio:observation": {
        "@id": "_:N966c551ec00340ae9b19e13890c2782a"
      }
