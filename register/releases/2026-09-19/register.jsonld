        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A facility where persons applying for international protection and beneficiaries of temporary protection are accommodated and that provides the reception services for them. Group homes and supported housing units intended for children are reception centres, too. See also international protection, temporary protection."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
