    {
      "@id": "term:european-union",
      "@type": [
        "skos:Concept",
        "tapio:Term"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The European Union is a political and economic union that has 27 European member states: Austria, Belgium, Bulgaria, Croatia, Cyprus, Czechia, Denmark, Estonia, Finland, France, Germany, Greece, Hungary, Ireland, Italy, Latvia, Lithuania, Luxembourg, Malta, the Netherlands, Poland, Portugal, Romania, Slovakia, Slovenia, Spain and Sweden."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "European Union"
        },
        {
          "@language": "fi",
          "@value": "Euroopan unioni (EU)"
        },
        {
          "@language": "sv",
          "@value": "Europeiska unionen (EU)"
        }
      ],
      "tapio:observation": {
        "@id": "_:N16500b473bd84facb9b4d14a5900e0c6"
      }
    },
