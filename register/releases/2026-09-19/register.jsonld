    {
      "@id": "step:denial-of-admittance-or-stay",
      "@type": [
        "skos:Concept",
        "tapio:ProcessStep"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Procedure for removing a person from the country. When a foreign national has not been issued with a residence permit and a decision is made to remove the person from the country, he or she is denied admittance or stay. Cf. deportation."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
