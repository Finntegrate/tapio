    {
      "@id": "term:non-refoulement",
      "@type": [
        "skos:Concept",
        "tapio:Term"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "According to the principle of non-refoulement, no one may be sent back to an area where he or she could be subject to the death penalty, torture, persecution or other inhuman treatment or other treatment violating human dignity."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "non-refoulement"
        },
        {
          "@language": "fi",
          "@value": "palautuskielto (non-refoulement)"
        },
        {
          "@language": "sv",
          "@value": "förbud mot tillbakasändning, förbud mot återsändande"
        }
      ],
      "tapio:observation": {
        "@id": "_:N0027d04839e94623b5fb56e116760b96"
      }
    },
