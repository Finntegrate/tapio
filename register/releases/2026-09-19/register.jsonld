    {
      "@id": "term:parentage-principle",
      "@type": [
        "skos:Concept",
        "tapio:Term"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2003-06-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A principle according to which a child acquires the citizenship of his or her parent (ius sanguinis). The inheritance principle is a primary principle in the Finnish Citizenship Act. Cf. birthplace principle."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "parentage principle"
        },
        {
          "@language": "fi",
          "@value": "periytymisperiaate"
        },
        {
          "@language": "sv",
          "@value": "härstamningsprincipen"
        }
      ],
