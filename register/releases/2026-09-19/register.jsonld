      }
    },
    {
      "@id": "svc:reception-unit",
      "@type": [
        "skos:Concept",
        "tapio:Service"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Reception unit is a generic concept that covers all premises where asylum seekers are accommodated. A reception unit can refer to, for example, reception centres and temporary accommodation units. See also reception centre."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
