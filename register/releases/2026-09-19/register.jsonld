      },
      "skos:definition": {
        "@language": "en",
        "@value": "A card issued by the Finnish Immigration Service, with which non-EU citizens who are family members of EU citizens can prove their right of residence in Finland. Biometric identifiers stored on the card’s chip include a facial image and two fingerprints. The residence card is not an official identity document. Cf. residence permit card. See EU citizen."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Residence card of a family member of an EU citizen"
        },
        {
          "@language": "fi",
          "@value": "Perheenjäsenen oleskelukortti"
        },
        {
          "@language": "sv",
          "@value": "Uppehållskort för familjemedlem"
        }
      ],
