      }
    },
    {
      "@id": "status:expatriate-finn",
      "@type": [
        "skos:Concept",
        "tapio:LegalStatus"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An expatriate Finn is a Finnish citizen or a person of Finnish origin who lives permanently outside Finland. See Finnish citizen, Finnish origin."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "expatriate Finn"
        },
        {
          "@language": "fi",
          "@value": "ulkosuomalainen"
        },
        {
          "@language": "sv",
          "@value": "utlandsfinländare"
        }
      ],
      "tapio:observation": {
