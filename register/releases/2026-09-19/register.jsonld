      },
      "skos:definition": {
        "@language": "en",
        "@value": "A fixed-term residence permit. The permit is issued to a foreign national who does not intend to stay in Finland permanently. The permit must be renewed before it expires. A temporary residence permit bears the letter B. Cf. continuous residence permit."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
