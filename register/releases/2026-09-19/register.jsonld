        "@value": "2003-06-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A foreign national may be granted Finnish citizenship on application if the requirements laid down in the Citizenship Act are met. Exceptions may be made as provided in the Act. Cf. citizenship declaration."
      },
