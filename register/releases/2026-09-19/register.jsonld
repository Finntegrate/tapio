    {
      "@id": "status:temporary-protection",
      "@type": [
        "skos:Concept",
        "tapio:LegalStatus"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Temporary protection may be given to foreign nationals who need international protection and who cannot return safely to their home country or country of permanent residence, because there has been a massive displacement of people in the country or its neighbouring areas as a result of an armed conflict, some other violent situation or an environmental disaster. Providing temporary protection requires that the need for protection may be considered to be of short duration."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Temporary protection"
        },
        {
          "@language": "fi",
          "@value": "Tilapäinen suojelu"
        },
        {
          "@language": "sv",
          "@value": "Tillfälligt skydd"
        }
      ],
