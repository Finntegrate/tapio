    {
      "@id": "step:deportation",
      "@type": [
        "skos:Concept",
        "tapio:ProcessStep"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Procedure for removing a person from the country. When a foreign national has been issued with a residence permit but a decision is made to remove the person from the country, he or she will be deported. Cf. refusal of entry."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "deportation"
        },
        {
          "@language": "fi",
          "@value": "karkottaminen"
        },
        {
          "@language": "sv",
          "@value": "utvisning"
        }
      ],
      "tapio:handledBy": {
        "@id": "org:migri"
      },
      "tapio:observation": {
