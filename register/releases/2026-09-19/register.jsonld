        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A travel document issued by the authorities of a person's home country or country of residence, which a foreign national must hold when entering Finland and while residing in Finland (excluding citizens of the Nordic countries, among others)."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
