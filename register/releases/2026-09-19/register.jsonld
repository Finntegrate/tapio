    {
      "@id": "permit:p-eu-residence-permit",
      "@type": [
        "skos:Concept",
        "tapio:Permit"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "long-term resident's EU residence permit"
        },
        {
          "@language": "en",
          "@value": "EU residence permit"
        }
      ],
      "skos:broader": {
        "@id": "permit:residence-permit"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A long-term resident’s EU residence permit that can be issued to a third-country national after he or she has resided within the territory of the European Union for a continuous period of five years. The permit is valid until further notice. An EU residence permit bears the letters P-EU. See third-country national."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "P-EU permit"
        },
        {
          "@language": "fi",
          "@value": "P-EU-oleskelulupa"
        },
        {
          "@language": "sv",
          "@value": "P-EU-uppehållstillstånd"
        }
      ],
      "tapio:handledBy": {
        "@id": "org:migri"
      },
