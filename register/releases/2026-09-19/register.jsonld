      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:broader": {
        "@id": "status:refugee"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A person considered a refugee by the UN refugee agency UNHCR who has been granted a residence permit under the refugee quota verified in the Finnish state budget. In recent years, the Finnish refugee quota has been 750–1,050 people. See also emergency cases, refugee."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
