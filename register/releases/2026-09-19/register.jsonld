    {
      "@id": "step:consider-application-inadmissible",
      "@type": [
        "skos:Concept",
        "tapio:ProcessStep"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Considering an application inadmissible means that the application is not examined in substance. However, the Finnish Immigration Service will always conduct a preliminary examination and decide whether your application contains grounds for continuing the examination. If there are such grounds, the application will be examined in substance. If there are no such grounds, you may get a decision on your application being dismissed as inadmissible."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "considering an application inadmissible"
        },
        {
          "@language": "fi",
          "@value": "tutkimatta jättäminen"
        },
        {
          "@language": "sv",
          "@value": "avvisande av ansökan utan prövning"
        }
      ],
      "tapio:observation": {
        "@id": "_:N639b8efaefc74f868c945bdefef120f8"
      }
    },
