    {
      "@id": "step:tracing",
      "@type": [
        "skos:Concept",
        "tapio:ProcessStep"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Tracing means establishing the location of the parents or a guardian of an unaccompanied minor or of a child victim of human trafficking who applies for international protection."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
