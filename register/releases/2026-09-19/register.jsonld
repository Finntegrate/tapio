      "skos:broader": {
        "@id": "permit:residence-permit"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A fixed-term residence permit. The permit is issued to a foreign national who has arrived in Finland with the intention of permanent immigration. The permit must be renewed before the permit expires. A continuous residence permit bears the letter A. Cf. temporary residence permit."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:notation": "A",
