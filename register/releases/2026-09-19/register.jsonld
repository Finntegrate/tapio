    {
      "@id": "term:finnish-origin",
      "@type": [
        "skos:Concept",
        "tapio:Term"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Finnish origin refers to Finnish citizens, former Finnish citizens, descendants of persons who have acquired Finnish citizenship by birth and, in residence permit matters, also persons of Finnish ethnic origin. See also Finnish citizen, Finnish citizen by birth, citizenship, (ethnic) nationality, ethnic origin."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Finnish origin"
        },
        {
          "@language": "fi",
          "@value": "suomalainen syntyperä"
        },
        {
          "@language": "sv",
          "@value": "finländsk härkomst"
        }
      ],
      "tapio:observation": {
        "@id": "_:Naf82ace97871439da2cfbb28ac9fd6f0"
      }
    },
