    {
      "@id": "term:manifestly-unfounded-application",
      "@type": [
        "skos:Concept",
        "tapio:Term"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An asylum application can be considered manifestly unfounded if 1) no serious violations of human rights or other grounds that are related to non-refoulement have been presented, or if the claims presented are clearly implausible, 2) the applicant obviously intends to abuse the asylum procedure or 3) the applicant comes from a safe country of origin where he or she may be returned. See also non-refoulement."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "manifestly unfounded application"
        },
        {
          "@language": "fi",
          "@value": "ilmeisen perusteeton hakemus"
        },
        {
          "@language": "sv",
          "@value": "uppenbart ogrundad ansökan"
        }
      ],
      "tapio:observation": {
        "@id": "_:N84619f893ccc4e4682e00fb295ac77e9"
      }
    },
    {
      "@id": "_:N84619f893ccc4e4682e00fb295ac77e9",
      "@type": "tapio:Observation",
      "dcterms:date": {
        "@type": "xsd:date",
        "@value": "2026-09-19"
      },
      "dcterms:publisher": "migri",
      "dcterms:source": {
        "@id": "https://migri.fi/en/glossary"
      }
    },
    {
      "@id": "permit:residence-permit",
      "@type": [
        "skos:Concept",
        "tapio:Permit"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:closeMatch": {
        "@id": "yso:p6463"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A permit issued to a foreign national for a purpose other than tourism or a comparable short-term residence that entitles the holder to enter the country repeatedly and stay in the country. Residence permits are either fixed-term or permanent. A residence permit can be issued on the basis of, for example, work, self-employment, studies or family ties. See fixed-term residence permit, permanent residence permit. See also visa."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Residence permit"
        },
        {
          "@language": "fi",
          "@value": "Oleskelulupa"
        },
        {
          "@language": "sv",
          "@value": "Uppehållstillstånd"
        }
      ],
      "skos:related": {
        "@id": "law:aliens-act"
      },
      "tapio:handledBy": {
        "@id": "org:migri"
      },
