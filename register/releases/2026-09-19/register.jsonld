    {
      "@id": "svc:registration-centre",
      "@type": [
        "skos:Concept",
        "tapio:Service"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A registration centre is a unit for the reception and registration of newly arrived asylum seekers. After being registered, the asylum seekers move to reception centres. See also reception centre."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
