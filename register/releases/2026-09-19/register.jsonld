    {
      "@id": "term:emergency-cases",
      "@type": [
        "skos:Concept",
        "tapio:Term"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Persons who the UN refugee agency UNHCR considers to be refugees in need of urgent resettlement, often due to their personal safety or health. These persons are admitted into the country on the basis of UNHCR’s documents without being interviewed by the Finnish authorities. The emergency cases that are admitted into Finland are a part of the yearly refugee quota. In recent years, the yearly number of emergency cases admitted into Finland has been 100. See also quota refugee."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "emergency cases"
        },
        {
          "@language": "fi",
          "@value": "hätätapaukset"
        },
        {
          "@language": "sv",
          "@value": "akuta fall"
        }
      ],
      "skos:related": {
        "@id": "status:quota-refugee"
      },
      "tapio:observation": {
        "@id": "_:N78877b11668742e988b2866708fe9a8a"
      }
    },
