        "skos:Concept",
        "tapio:LegalStatus"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:broader": {
        "@id": "status:refugee"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A refugee whose need of protection has arisen after he or she has left his or her home country. See also refugee."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
