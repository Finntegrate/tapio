    {
      "@id": "term:schengen-area",
      "@type": [
        "skos:Concept",
        "tapio:Term"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The Schengen area refers to the area of states applying the Schengen acquis. These states include Austria, Belgium, Bulgaria, Czechia, Croatia, Denmark, Estonia, Finland, France, Germany, Greece, Hungary, Iceland, Italy, Latvia, Liechtenstein, Lithuania, Luxembourg, Malta, the Netherlands, Norway, Poland, Portugal, Romania, Slovakia, Slovenia, Spain, Sweden and Switzerland."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "Schengen area"
        },
        {
          "@language": "fi",
          "@value": "Schengen-alue"
        },
        {
          "@language": "sv",
          "@value": "Schengenområdet"
        }
      ],
      "tapio:observation": {
