        "skos:Concept",
        "tapio:Document"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A travel document issued to a foreign national who has been granted refugee status. A refugee travel document is not an official identity document. See refugee. Cf. alien’s passport."
      },
