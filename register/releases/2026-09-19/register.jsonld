    {
      "@id": "status:eu-citizen",
      "@type": [
        "skos:Concept",
        "tapio:LegalStatus"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A citizen of a member state in the European Union (EU) or in Iceland, Liechtenstein, Norway or Switzerland. EU citizens have the right to move freely within the territory of the Union. The provisions on free movement also apply to citizens of Iceland, Liechtenstein and Norway based on the EEA Agreement, as well as to citizens of Switzerland based on a separate agreement with the EU. See European Union (EU), European Economic Area (EAA)."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "EU citizen or a comparable person"
        },
        {
          "@language": "fi",
          "@value": "EU-kansalainen ja häneen rinnastettava"
        },
        {
          "@language": "sv",
          "@value": "EU-medborgare och en därmed jämförbar person"
        }
      ],
      "tapio:observation": {
        "@id": "_:N91aadf576a164aa997503ea81cd747e5"
      }
    },
