    {
      "@id": "step:detention",
      "@type": [
        "skos:Concept",
        "tapio:ProcessStep"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An interim measure, means of monitoring. A foreign national may be held in detention if there are grounds to believe that he or she will, for example, hide in order to avoid denial of admittance or stay or deportation. An asylum seeker may be held in detention if it is necessary to establish his or her identity."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "detention"
        },
        {
          "@language": "fi",
          "@value": "säilöönotto"
        },
        {
          "@language": "sv",
          "@value": "tagande i förvar, förvarstagande"
        }
      ],
      "tapio:observation": {
        "@id": "_:N7cdafdd4522f44a29e7722bae216f369"
      }
    },
    {
      "@id": "_:N7cdafdd4522f44a29e7722bae216f369",
      "@type": "tapio:Observation",
      "dcterms:date": {
        "@type": "xsd:date",
        "@value": "2026-09-19"
      },
      "dcterms:publisher": "migri",
      "dcterms:source": {
        "@id": "https://migri.fi/en/glossary"
      }
    },
    {
      "@id": "step:assisted-voluntary-return",
      "@type": [
        "skos:Concept",
        "tapio:ProcessStep"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Assisted voluntary return refers to an arrangement where a third-country national who has applied for international protection, a beneficiary of temporary protection, a victim of human trafficking or a person who has been granted a residence permit under section 51 of the Aliens Act can receive assistance and compensation for travel and relocation costs to his or her home country or another country. A further requirement is that the applicant must leave the country voluntarily and with permanent intent after having cancelled his or her application or after the application has been rejected. See international protection, third-country national, temporary protection. Cf. voluntary return."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "assisted voluntary return"
        },
        {
          "@language": "fi",
          "@value": "avustettu vapaaehtoinen paluu"
        },
        {
          "@language": "sv",
          "@value": "assisterad frivillig återresa"
        }
      ],
      "tapio:observation": {
        "@id": "_:N271c0f161f0544c2ac968e2c226d0d2f"
      }
    },
    {
      "@id": "_:N271c0f161f0544c2ac968e2c226d0d2f",
      "@type": "tapio:Observation",
      "dcterms:date": {
        "@type": "xsd:date",
        "@value": "2026-09-19"
      },
      "dcterms:publisher": "migri",
      "dcterms:source": {
        "@id": "https://migri.fi/en/glossary"
      }
    },
    {
      "@id": "permit:fixed-term-residence-permit",
      "@type": [
        "skos:Concept",
        "tapio:Permit"
      ],
      "sdo:validFrom": {
        "@type": "xsd:date",
        "@value": "2004-05-01"
      },
      "skos:broader": {
        "@id": "permit:residence-permit"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A residence permit that is valid for a certain time period. Fixed-term residence permits are issued for a continuous or temporary residence. See continuous residence permit, temporary residence permit. Cf. permanent residence permit."
      },
      "skos:inScheme": {
        "@id": "https://tapio.finntegrate.org/register/scheme"
      },
      "skos:prefLabel": [
        {
          "@language": "en",
          "@value": "fixed-term residence permit"
        },
        {
          "@language": "fi",
          "@value": "määräaikainen oleskelulupa"
        },
        {
          "@language": "sv",
          "@value": "tidsbegränsat uppehållstillstånd"
        }
      ],
      "tapio:observation": {
        "@id": "_:Nebd567e505074c5aa97ab10d07090391"
      }
    },
