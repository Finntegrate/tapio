term:registered-partnership a skos:Concept,
        tapio:Term ;
    skos:definition "An official relationship between two persons of the same sex. A registered partnership is in many ways comparable to a marriage."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "registered partnership"@en,
        "rekisteröity parisuhde"@fi,
        "registrerat partnerskap"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

