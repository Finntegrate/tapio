            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/asiakasnumero-ja-diaarinumero> ] .

term:emergency-cases a skos:Concept,
        tapio:Term ;
    skos:definition "Persons who the UN refugee agency UNHCR considers to be refugees in need of urgent resettlement, often due to their personal safety or health. These persons are admitted into the country on the basis of UNHCR’s documents without being interviewed by the Finnish authorities. The emergency cases that are admitted into Finland are a part of the yearly refugee quota. In recent years, the yearly number of emergency cases admitted into Finland has been 100. See also quota refugee."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "emergency cases"@en,
        "hätätapaukset"@fi,
        "akuta fall"@sv ;
    skos:related status:quota-refugee ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

term:ethnic-nationality a skos:Concept,
        tapio:Term ;
    skos:definition "Ethnic background. Belonging to a specific nation or a group of people (e.g. Ingrian Finns, Kurds, Roma). Ethnic nationality has a different meaning than citizenship. For instance, a person of Kurdish ethnic origin may hold Finnish citizenship. Cf. citizenship."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "ethnic nationality"@en,
        "kansallisuus"@fi,
        "nationalitet"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

term:european-economic-area a skos:Concept,
        tapio:Term ;
    skos:definition "The European Economic Area is a common market. Member states of the European Union as well as Iceland, Liechtenstein and Norway belong to the European Economic Area. See European Union (EU)."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "European Economic Area"@en,
        "Euroopan talousalue (ETA)"@fi,
        "Europeiska ekonomiska samarbetsområdet (EES)"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

term:european-union a skos:Concept,
        tapio:Term ;
    skos:definition "The European Union is a political and economic union that has 27 European member states: Austria, Belgium, Bulgaria, Croatia, Cyprus, Czechia, Denmark, Estonia, Finland, France, Germany, Greece, Hungary, Ireland, Italy, Latvia, Lithuania, Luxembourg, Malta, the Netherlands, Poland, Portugal, Romania, Slovakia, Slovenia, Spain and Sweden."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "European Union"@en,
        "Euroopan unioni (EU)"@fi,
        "Europeiska unionen (EU)"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

term:finnish-origin a skos:Concept,
        tapio:Term ;
    skos:definition "Finnish origin refers to Finnish citizens, former Finnish citizens, descendants of persons who have acquired Finnish citizenship by birth and, in residence permit matters, also persons of Finnish ethnic origin. See also Finnish citizen, Finnish citizen by birth, citizenship, (ethnic) nationality, ethnic origin."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Finnish origin"@en,
        "suomalainen syntyperä"@fi,
        "finländsk härkomst"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

term:immigration-legislation a skos:Concept,
        tapio:Term ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Legislation"@en,
        "Lainsäädäntö"@fi,
        "Lagstiftning"@sv ;
    skos:related law:aliens-act,
        law:citizenship-act ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
