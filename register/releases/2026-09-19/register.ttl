step:apply-for-asylum a skos:Concept,
        tapio:ProcessStep ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Applying for asylum"@en,
        "Turvapaikka Suomesta"@fi,
        "Asyl i Finland"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
