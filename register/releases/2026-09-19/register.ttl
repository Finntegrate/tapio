            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/forskare> ] .

permit:residence-card a skos:Concept,
        tapio:Permit ;
    skos:definition "A card issued by the Finnish Immigration Service, with which non-EU citizens who are family members of EU citizens can prove their right of residence in Finland. Biometric identifiers stored on the card’s chip include a facial image and two fingerprints. The residence card is not an official identity document. Cf. residence permit card. See EU citizen."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Residence card of a family member of an EU citizen"@en,
        "Perheenjäsenen oleskelukortti"@fi,
        "Uppehållskort för familjemedlem"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/residence-card-for-family-members> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/perheenjasenen-oleskelukortti> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/uppehallskort-for-familjemedlem> ] .

permit:right-of-permanent-residence a skos:Concept,
        tapio:Permit ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Right of permanent residence of an EU citizen"@en,
        "EU-kansalaisen pysyvä oleskeluoikeus"@fi,
        "Permanent uppehållsrätt"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
