            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/ansokan-om-uppehallstillstand-for-studier> ] .

permit:temporary-residence-permit a skos:Concept,
        tapio:Permit ;
    skos:broader permit:residence-permit ;
    skos:definition "A fixed-term residence permit. The permit is issued to a foreign national who does not intend to stay in Finland permanently. The permit must be renewed before it expires. A temporary residence permit bears the letter B. Cf. continuous residence permit."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:notation "B" ;
    skos:prefLabel "temporary residence permit"@en,
        "tilapäinen oleskelulupa"@fi,
        "tillfälligt uppehållstillstånd"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

permit:visa a skos:Concept,
        tapio:Permit ;
    skos:closeMatch <yso:p16593> ;
    skos:definition "A permit to enter the country, which is issued for a short and temporary stay of up to 90 days. The Finnish missions make decisions on issuing visas. See mission."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "visa"@en,
        "viisumi"@fi,
        "visum, visering"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:finnish-mission ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "yso" ;
            dcterms:source <http://www.yso.fi/onto/yso/p16593> ;
            rdfs:comment "YSO: visas / viisumit / visum"@en ] .

svc:incomes-register a skos:Concept,
        tapio:Service ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Incomes Register"@en,
        "Tulorekisteri"@fi,
        "Inkomstregistret"@sv ;
