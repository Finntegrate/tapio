            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/servicestallen> ] .

svc:reception-centre a skos:Concept,
        tapio:Service ;
    skos:definition "A facility where persons applying for international protection and beneficiaries of temporary protection are accommodated and that provides the reception services for them. Group homes and supported housing units intended for children are reception centres, too. See also international protection, temporary protection."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "reception centre"@en,
        "vastaanottokeskus"@fi,
        "förläggning"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

svc:reception-unit a skos:Concept,
        tapio:Service ;
    skos:definition "Reception unit is a generic concept that covers all premises where asylum seekers are accommodated. A reception unit can refer to, for example, reception centres and temporary accommodation units. See also reception centre."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "reception unit"@en,
        "vastaanottoyksikkö"@fi,
        "mottagningsenhet"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

svc:registration-centre a skos:Concept,
        tapio:Service ;
    skos:definition "A registration centre is a unit for the reception and registration of newly arrived asylum seekers. After being registered, the asylum seekers move to reception centres. See also reception centre."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "registration centre"@en,
        "järjestelykeskus"@fi,
        "flyktingsluss"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:asylum a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "A residence permit issued to a foreign national under the asylum procedure on the basis of his or her refugee status. See refugee."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "asylum"@en,
        "turvapaikka"@fi,
        "asyl"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:asylum-seeker a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "A person who seeks protection and right of residence in a foreign state. An asylum seeker is granted refugee status if he or she is granted asylum. See asylum, refugee."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "asylum seeker"@en,
        "turvapaikanhakija"@fi,
        "asylsökande"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:dual-citizenship a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "A person may be a citizen of two or several countries."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "dual or multiple citizenship"@en,
        "kaksoiskansalaisuus/monikansalaisuus"@fi,
        "dubbelt/flerfaldigt medborgarskap"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:emigrant a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "A person who moves from a country (Finland). Cf. immigrant; migrant."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "emigrant"@en,
        "maastamuuttaja"@fi,
        "utvandrare"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:eu-citizen a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "A citizen of a member state in the European Union (EU) or in Iceland, Liechtenstein, Norway or Switzerland. EU citizens have the right to move freely within the territory of the Union. The provisions on free movement also apply to citizens of Iceland, Liechtenstein and Norway based on the EEA Agreement, as well as to citizens of Switzerland based on a separate agreement with the EU. See European Union (EU), European Economic Area (EAA)."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "EU citizen or a comparable person"@en,
        "EU-kansalainen ja häneen rinnastettava"@fi,
        "EU-medborgare och en därmed jämförbar person"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:expatriate-finn a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "An expatriate Finn is a Finnish citizen or a person of Finnish origin who lives permanently outside Finland. See Finnish citizen, Finnish origin."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "expatriate Finn"@en,
        "ulkosuomalainen"@fi,
        "utlandsfinländare"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:finnish-citizen-by-birth a skos:Concept,
        tapio:LegalStatus ;
    skos:broader status:finnish-citizen ;
    skos:definition "A person who has acquired Finnish citizenship by birth. See citizenship."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Finnish citizen by birth"@en,
        "syntyperäinen Suomen kansalainen"@fi,
        "infödd finsk medborgare"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:finnish-citizenship a skos:Concept,
        tapio:LegalStatus ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Finnish citizenship"@en,
        "Suomen kansalaisuus"@fi,
        "Finskt medborgarskap"@sv ;
    skos:related law:citizenship-act ;
    sdo:validFrom "2003-06-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/finnish-citizenship> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/suomen-kansalaisuus> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/finskt-medborgarskap> ] .

status:foreign-national a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "A person who is not a Finnish citizen. In legal language, also the word ‘alien’ is used. See Finnish citizen."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "foreign national"@en,
        "ulkomaalainen"@fi,
        "utlänning"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:humanitarian-protection a skos:Concept,
        tapio:LegalStatus ;
    skos:changeNote "Ceased to be a ground for granting a residence permit on 16 May 2016; nothing replaced it directly. Applicants are assessed for asylum and subsidiary protection instead."@en ;
    skos:definition "Reason for granting a residence permit until 16 May 2016. It was possible to grant a residence permit on the basis of humanitarian protection when the requirements for granting asylum or providing subsidiary protection were not met, but the applicant could not return to his or her home country or country of former habitual residence because of an environmental catastrophe. Another possible reason was a poor security situation which might have been due to an armed conflict or a poor human rights situation. See also asylum, subsidiary protection."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "humanitarian protection"@en,
        "humanitaarinen suojelu"@fi,
        "humanitärt skydd"@sv ;
    skos:related status:subsidiary-protection ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    sdo:validThrough "2016-05-16"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:immigrant a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "A person who moves into a country (Finland). Cf. emigrant; migrant."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "immigrant"@en,
        "maahanmuuttaja"@fi,
        "invandrare"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:refugee-sur-place a skos:Concept,
        tapio:LegalStatus ;
    skos:broader status:refugee ;
    skos:definition "A refugee whose need of protection has arisen after he or she has left his or her home country. See also refugee."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "refugee sur place"@en,
        "sur place -pakolainen"@fi,
        "flykting ”sur place”"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:returnee a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "In residence permit matters, a returnee refers to a person moving to Finland who is of Finnish extraction or a person who otherwise has close ties to Finland (is a former Finnish citizen, a descendant of a person who is a Finnish citizen by birth or is otherwise Finnish in origin, for example an Ingrian Finn). See also Finnish citizen, Finnish citizen by birth, Finnish origin."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "returnee"@en,
        "paluumuuttaja"@fi,
        "återflyttare"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:sponsor a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "A person residing in Finland whose family member applies for a residence permit to Finland on the basis of family ties in order to be together with the sponsor."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "sponsor"@en,
        "perheenkokoaja"@fi,
        "anknytningsperson"@sv ;
    skos:related permit:family-ties-residence-permit ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

status:temporary-protection a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "Temporary protection may be given to foreign nationals who need international protection and who cannot return safely to their home country or country of permanent residence, because there has been a massive displacement of people in the country or its neighbouring areas as a result of an armed conflict, some other violent situation or an environmental disaster. Providing temporary protection requires that the need for protection may be considered to be of short duration."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Temporary protection"@en,
        "Tilapäinen suojelu"@fi,
        "Tillfälligt skydd"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/tillfalligt-skydd> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/temporary-protection> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/tilapainen-suojelu> ] .

status:third-country-national a skos:Concept,
        tapio:LegalStatus ;
    skos:definition "A foreign national who is not an EU citizen or a comparable person (a citizen of Iceland, Liechtenstein, Norway or Switzerland). See EU citizen or a comparable person, European Union (EU)."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "third-country national"@en,
        "kolmannen maan kansalainen"@fi,
        "tredjelandsmedborgare"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

