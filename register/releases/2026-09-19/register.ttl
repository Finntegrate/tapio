        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/lagstiftning> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/lainsaadanto> ] .

term:legal-residence a skos:Concept,
        tapio:Term ;
    skos:definition "Legal stay means that a foreign national is residing in the country with appropriate and valid permits. The stay is legal on the basis of a valid visa, exemption from the visa requirement or a valid residence permit. A foreign national may reside legally in the country also while his or her residence permit or asylum application is being processed."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "legal residence"@en,
        "laillinen oleskelu"@fi,
        "laglig vistelse"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

term:manifestly-unfounded-application a skos:Concept,
        tapio:Term ;
    skos:definition "An asylum application can be considered manifestly unfounded if 1) no serious violations of human rights or other grounds that are related to non-refoulement have been presented, or if the claims presented are clearly implausible, 2) the applicant obviously intends to abuse the asylum procedure or 3) the applicant comes from a safe country of origin where he or she may be returned. See also non-refoulement."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "manifestly unfounded application"@en,
        "ilmeisen perusteeton hakemus"@fi,
        "uppenbart ogrundad ansökan"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

term:non-refoulement a skos:Concept,
        tapio:Term ;
    skos:definition "According to the principle of non-refoulement, no one may be sent back to an area where he or she could be subject to the death penalty, torture, persecution or other inhuman treatment or other treatment violating human dignity."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "non-refoulement"@en,
        "palautuskielto (non-refoulement)"@fi,
        "förbud mot tillbakasändning, förbud mot återsändande"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

term:parentage-principle a skos:Concept,
        tapio:Term ;
    skos:definition "A principle according to which a child acquires the citizenship of his or her parent (ius sanguinis). The inheritance principle is a primary principle in the Finnish Citizenship Act. Cf. birthplace principle."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "parentage principle"@en,
        "periytymisperiaate"@fi,
        "härstamningsprincipen"@sv ;
    sdo:validFrom "2003-06-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

