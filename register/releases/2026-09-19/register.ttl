doc:aliens-passport a skos:Concept,
        tapio:Document ;
    skos:definition "A travel document that can be issued to a foreign national if he or she cannot obtain a passport from the authorities of his or her home country, or if he or she is stateless, or if there are other special reasons for issuing an alien’s passport to him or her. Foreign nationals who have been granted a residence permit on the basis of subsidiary protection are issued with an alien’s passport. An alien’s passport is not an official identity document. See subsidiary protection. Cf. refugee travel document."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Alien's passport"@en,
        "Muukalaispassi"@fi,
        "Främlingspass"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/alien-s-passport> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/framlingspass> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/muukalaispassi> ] .

doc:passport a skos:Concept,
        tapio:Document ;
    skos:definition "A travel document issued by the authorities of a person's home country or country of residence, which a foreign national must hold when entering Finland and while residing in Finland (excluding citizens of the Nordic countries, among others)."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "passport"@en,
        "passi"@fi,
        "pass"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

doc:refugee-travel-document a skos:Concept,
        tapio:Document ;
    skos:definition "A travel document issued to a foreign national who has been granted refugee status. A refugee travel document is not an official identity document. See refugee. Cf. alien’s passport."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Refugee travel document"@en,
        "Pakolaisen matkustusasiakirja"@fi,
        "Resedokument för flykting"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/refugee-travel-document> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/resedokument-for-flykting> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/pakolaisen-matkustusasiakirja> ] .

