            dcterms:source <https://migri.fi/tulorekisteri> ] .

svc:migri-service-point a skos:Concept,
        tapio:Service ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Service point"@en,
        "Palvelupisteet"@fi,
        "Serviceställen"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
