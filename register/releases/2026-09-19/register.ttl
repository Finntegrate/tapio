            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/asyl-i-finland> ] .

step:assisted-voluntary-return a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "Assisted voluntary return refers to an arrangement where a third-country national who has applied for international protection, a beneficiary of temporary protection, a victim of human trafficking or a person who has been granted a residence permit under section 51 of the Aliens Act can receive assistance and compensation for travel and relocation costs to his or her home country or another country. A further requirement is that the applicant must leave the country voluntarily and with permanent intent after having cancelled his or her application or after the application has been rejected. See international protection, third-country national, temporary protection. Cf. voluntary return."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "assisted voluntary return"@en,
        "avustettu vapaaehtoinen paluu"@fi,
        "assisterad frivillig återresa"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

step:asylum-examination a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "A procedure in which the Finnish Immigration Service or the Border Guard first establishes the identity and travel route of the asylum seeker and whether his or her application can be processed in Finland. After that, the Finnish Immigration Service interviews the applicant in order to establish the grounds for his or her asylum application. See asylum interview."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "asylum examination"@en,
        "turvapaikkatutkinta"@fi,
        "asylutredning"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

step:asylum-interview a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "The purpose of an asylum interview is to establish the grounds for an asylum application. The asylum interview is conducted by the Finnish Immigration Service."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "asylum interview"@en,
        "turvapaikkapuhuttelu"@fi,
        "asylsamtal"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

step:book-appointment a skos:Concept,
        tapio:ProcessStep ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Booking an appointment at a service point"@en,
        "Varaa aika palvelupisteeseen"@fi,
