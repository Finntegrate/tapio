            dcterms:source <https://migri.fi/sv/aterkallande-av-tillstand> ] .

term:birthplace-principle a skos:Concept,
        tapio:Term ;
    skos:definition "A principle according to which a child acquires citizenship on the basis of the place of birth (ius soli). The birthplace principle is a secondary principle in the Finnish Citizenship Act. Cf. parentage principle, inheritance principle."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "birthplace principle"@en,
        "syntymämaaperiaate"@fi,
        "territorialprincipen, födelselandsprincipen"@sv ;
    sdo:validFrom "2003-06-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

term:citizenship a skos:Concept,
        tapio:Term ;
    skos:definition "Citizenship means a legislative bond between an individual and a state determining the individual’s status in the state as well as the basic rights and duties existing between the individual and the state."@en ;
    skos:exactMatch <yso:p2736> ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "citizenship"@en,
        "kansalaisuus"@fi,
        "medborgarskap"@sv ;
    skos:related law:citizenship-act ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "yso" ;
            dcterms:source <http://www.yso.fi/onto/yso/p2736> ;
            rdfs:comment "YSO: citizenship / kansalaisuus / medborgarskap"@en ] .

term:country-of-nationality a skos:Concept,
        tapio:Term ;
    skos:definition "The country of which a person holds citizenship. See citizenship."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "country of nationality"@en,
        "kansalaisuusvaltio"@fi,
        "medborgarskapsland"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

