step:tracing a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "Tracing means establishing the location of the parents or a guardian of an unaccompanied minor or of a child victim of human trafficking who applies for international protection."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "tracing"@en,
        "jäljittäminen"@fi,
        "spårande"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

step:visit-finnish-mission a skos:Concept,
        tapio:ProcessStep ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Handling your matters at a Finnish mission"@en,
        "Asiointi Suomen edustustossa"@fi,
        "Att uträtta ärenden vid en finsk beskickning"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:finnish-mission ;
