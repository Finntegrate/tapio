permit:fixed-term-residence-permit a skos:Concept,
        tapio:Permit ;
    skos:broader permit:residence-permit ;
    skos:definition "A residence permit that is valid for a certain time period. Fixed-term residence permits are issued for a continuous or temporary residence. See continuous residence permit, temporary residence permit. Cf. permanent residence permit."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "fixed-term residence permit"@en,
        "määräaikainen oleskelulupa"@fi,
        "tidsbegränsat uppehållstillstånd"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
