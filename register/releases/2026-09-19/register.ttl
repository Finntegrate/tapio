permit:student-residence-permit a skos:Concept,
        tapio:Permit ;
    skos:broader permit:residence-permit ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Residence permit for studies"@en,
        "Opiskelijan oleskelulupahakemus"@fi,
        "Ansökan om uppehållstillstånd för studier"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
