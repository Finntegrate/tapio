permit:residence-permit a skos:Concept,
        tapio:Permit ;
    skos:closeMatch <yso:p6463> ;
    skos:definition "A permit issued to a foreign national for a purpose other than tourism or a comparable short-term residence that entitles the holder to enter the country repeatedly and stay in the country. Residence permits are either fixed-term or permanent. A residence permit can be issued on the basis of, for example, work, self-employment, studies or family ties. See fixed-term residence permit, permanent residence permit. See also visa."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Residence permit"@en,
        "Oleskelulupa"@fi,
        "Uppehållstillstånd"@sv ;
    skos:related law:aliens-act ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/oleskelulupa> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "yso" ;
            dcterms:source <http://www.yso.fi/onto/yso/p6463> ;
            rdfs:comment "YSO: residence permits / oleskeluluvat / uppehållstillstånd"@en ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/residence-permit> ],
