            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/informing-of-the-decision> ] .

step:detention a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "An interim measure, means of monitoring. A foreign national may be held in detention if there are grounds to believe that he or she will, for example, hide in order to avoid denial of admittance or stay or deportation. An asylum seeker may be held in detention if it is necessary to establish his or her identity."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "detention"@en,
        "säilöönotto"@fi,
        "tagande i förvar, förvarstagande"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

step:determine-citizenship-status a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "In unclear situations, the Finnish Immigration Service establishes which citizenship a person is considered to hold in Finland. See also citizenship."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "determination of citizenship status"@en,
        "kansalaisuusaseman määrittäminen"@fi,
        "bestämmande av medborgarskapsstatus"@sv ;
    sdo:validFrom "2003-06-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

step:dublin-procedure a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "The Dublin procedure is based on the EU Dublin Regulation and is conducted to determine the state responsible for examining an asylum application. The member states of the EU as well as Iceland, Liechtenstein, Norway and Switzerland apply the Regulation. Another country can be responsible for examining an application if the asylum seeker, for example, has family ties, a residence permit or a visa in another country applying the Regulation. Another country is also responsible for examining an application if the asylum seeker’s fingerprints have been entered in the Eurodac system after an illegal crossing of the external border of the EU. The country where an asylum seeker has previously sought asylum may also be responsible for examining the application. See European Union (EU), asylum."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Dublin procedure"@en,
        "Dublin-menettely"@fi,
        "Dublinförfarande"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

