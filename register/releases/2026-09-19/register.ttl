step:citizenship-application a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "A foreign national may be granted Finnish citizenship on application if the requirements laid down in the Citizenship Act are met. Exceptions may be made as provided in the Act. Cf. citizenship declaration."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Citizenship application"@en,
        "Kansalaisuushakemus aikuiselle"@fi,
        "Medborgarskapsansökan för vuxna"@sv ;
    sdo:validFrom "2003-06-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/kansalaisuus-aikuiselle> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/medborgarskap-for-vuxna> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/citizenship-for-adults> ] .

step:citizenship-declaration a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "Certain groups of people may acquire Finnish citizenship by declaration. These groups are specified in the Citizenship Act. Cf. citizenship application."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Citizenship declaration"@en,
        "Kansalaisuusilmoitus"@fi,
        "Medborgarskapsanmälan"@sv ;
    sdo:validFrom "2003-06-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/citizenship-declaration> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/sv/medborgarskapsanmalan> ],
        [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/kansalaisuusilmoitus> ] .

step:consider-application-inadmissible a skos:Concept,
        tapio:ProcessStep ;
    skos:definition "Considering an application inadmissible means that the application is not examined in substance. However, the Finnish Immigration Service will always conduct a preliminary examination and decide whether your application contains grounds for continuing the examination. If there are such grounds, the application will be examined in substance. If there are no such grounds, you may get a decision on your application being dismissed as inadmissible."@en ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "considering an application inadmissible"@en,
        "tutkimatta jättäminen"@fi,
        "avvisande av ansökan utan prövning"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:observation [ a tapio:Observation ;
            dcterms:date "2026-09-19"^^xsd:date ;
            dcterms:publisher "migri" ;
            dcterms:source <https://migri.fi/en/glossary> ] .

step:decision-notification a skos:Concept,
        tapio:ProcessStep ;
    skos:inScheme <https://tapio.finntegrate.org/register/scheme> ;
    skos:prefLabel "Notification of the decision"@en,
        "Tieto päätöksestä"@fi,
        "Delgivande av beslut"@sv ;
    sdo:validFrom "2004-05-01"^^xsd:date ;
    tapio:handledBy org:migri ;
    tapio:observation [ a tapio:Observation ;
