# LangSmith API key (get one at https://smith.langchain.com)
# Required for LangSmith observability. Without it, tracing is a no-op.
# LANGSMITH_API_KEY="ls_your_api_key_here"

# LangChain project name (optional, defaults to "tapio")
# Traces will be grouped under this project in the LangSmith UI.
# LANGCHAIN_PROJECT="tapio"

# LangSmith endpoint (optional, defaults to https://api.smith.langchain.com)
# Change only if using a self-hosted or alternative LangSmith endpoint.
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
